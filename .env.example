# 伺服器埠號
PORT=3000

# PostgreSQL 連線字串
# 本機開發範例(需先建立好資料庫,見 README):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wayan_dispatch

# JWT 簽章密鑰,正式環境請換成隨機長字串,不要使用預設值
JWT_SECRET=change-this-to-a-long-random-secret

# 允許的前端來源(CORS),多個網址用逗號分隔。留空則預設允許所有來源(僅建議開發環境使用)
CORS_ORIGIN=http://localhost:3000

# 展示帳號的初始密碼(僅在資料庫第一次建立、seed 使用者資料時生效)
# 正式環境請勿使用預設密碼,建立好帳號後應立即修改,並改用 /api/users 建立正式的管理員/調度員帳號
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# ---- LINE Bot(選用,不設定就不會啟用 LINE 功能,其他功能不受影響)----
# 在 LINE Developers Console 建立 Messaging API 頻道後取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 給「每日/每週報表」用的共用密鑰,自己設一組隨機字串即可,
# 外部排程服務(例如 cron-job.org)呼叫 /api/line/cron/daily 時要帶在 x-cron-secret header
CRON_SECRET=change-this-to-a-long-random-secret
