# For docker-compose.staging.yml only. Create fresh TEST credentials; never copy production .env.
# Use a newly generated URL-safe password (letters/numbers/_/-) for STAGING_DB_PASSWORD.
STAGING_DB_PASSWORD=
STAGING_JWT_SECRET=
STAGING_ADMIN_USERNAME=wayan-owner
STAGING_ADMIN_PASSWORD=
STAGING_CORS_ORIGIN=http://localhost:3080
STAGING_LINE_CHANNEL_SECRET=
STAGING_LINE_CHANNEL_ACCESS_TOKEN=
STAGING_CRON_SECRET=

# Optional dedicated staging service-account credentials for unattended Sheets writes.
# Grant this identity access only to the intended staging spreadsheet. Never use production keys.
STAGING_FLEET_SHEET_ID=
STAGING_GOOGLE_CLIENT_EMAIL=
STAGING_GOOGLE_PRIVATE_KEY=
